# Server Configuration
SERVER_PORT=3000
TZ=Asia/Jerusalem

# Default Endpoint URL (displayed when no schedule is active)
DEFAULT_ENDPOINT_URL=http://192.168.1.230:3007/main

# Scheduled Endpoints Configuration
# Format: ENDPOINT_{N}_URL=http://your.endpoint.url
#         ENDPOINT_{N}_SCHEDULE=Comma-separated schedule entries
# Schedule Entry Format: DayOfWeek|HH:MM|DurationMinutes (e.g., 1|08:00|20 for Monday 8:00 AM for 20 mins)
#                         *|HH:MM|DurationMinutes (e.g., *|14:00|5 for Every Day at 2:00 PM for 5 mins)
#                         *|hourly|DurationMinutes (e.g., *|hourly|5 for Every hour for 5 mins)
# DayOfWeek: 0=Sunday, 1=Monday, ..., 6=Saturday, *=Every Day
# Use 'hourly' for the specific hourly requirement.

# --- User Defined Endpoints ---

# Main News Endpoint Example (Every Day at 8:00 PM for 20 mins)
ENDPOINT_1_URL=http://192.168.1.153:8007
ENDPOINT_1_SCHEDULE=*|20:00|20

# Weather Endpoint Example (Every hour for 5 mins)
ENDPOINT_2_URL=http://192.168.1.153:8007
ENDPOINT_2_SCHEDULE=*|21:09|1

# Example: Specific day and time (Tuesday 10:30 AM for 15 mins)
# ENDPOINT_3_URL=http://some.other.endpoint:4000
# ENDPOINT_3_SCHEDULE=2|10:30|15

# Example: Multiple schedules for one endpoint (Weekdays at 9 AM for 10 mins AND Saturday noon for 30 mins)
# ENDPOINT_4_URL=http://another.one:5000
# ENDPOINT_4_SCHEDULE=1|09:00|10,2|09:00|10,3|09:00|10,4|09:00|10,5|09:00|10,6|12:00|30

# --- End User Defined Endpoints ---
